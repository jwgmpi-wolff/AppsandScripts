{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
    "manifestVersion": "1.29",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "${{PUBLISHER_NAME}}",
        "websiteUrl": "${{PUBLISHER_WEBSITE_URL}}",
        "privacyUrl": "${{PRIVACY_URL}}",
        "termsOfUseUrl": "${{TERMS_OF_USE_URL}}"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "FinOps CCoE${{APP_NAME_SUFFIX}}",
        "full": "FinOps CCoE Live Reporting"
    },
    "description": {
        "short": "Analyze live Azure cost, governance, and optimization data.",
        "full": "Run scoped, live Azure FinOps reports for spend, optimization, reservations, governance, sustainability, and AI usage."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "${{API_HOST}}"
    ]
}