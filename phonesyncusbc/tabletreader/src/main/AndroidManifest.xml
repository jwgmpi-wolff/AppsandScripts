<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.jerrywolff.phonesyncusbc" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_reader_adaptive"
        android:label="RecoverByBackup"
        android:roundIcon="@drawable/ic_reader_adaptive"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneSyncDataReader">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="RecoverByBackup"
            android:screenOrientation="userLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>