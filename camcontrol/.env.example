# ── IoT Hub connectivity (choose one) ────────────────────────────────────────
# Standalone device mode
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=<device>;SharedAccessKey=<key>

# IoT Edge module mode – set by the Edge runtime; do not populate manually
# IOTEDGE_WORKLOADURI=
# IOTEDGE_DEVICEID=

# ── Camera device ─────────────────────────────────────────────────────────────
# Linux: /dev/video0  |  Windows: 0  (OpenCV index)
CAMERA_DEVICE_PATH=/dev/video0

# ── Stream (disabled by default – enable only on secure local network) ────────
STREAM_ENABLED=false
STREAM_PROTOCOL=rtsp
STREAM_PORT=8554
# STREAM_USERNAME=<rotate-regularly>
# STREAM_PASSWORD=<rotate-regularly>

# ── Snapshots ─────────────────────────────────────────────────────────────────
SNAPSHOT_INTERVAL_SECONDS=0
SNAPSHOT_DIRECTORY=./data/snapshots

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
