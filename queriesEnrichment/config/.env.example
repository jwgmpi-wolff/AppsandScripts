# Example environment variables for local testing
# Copy this file to .env and update with your actual values

# Azure Subscription
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Azure Resource Group and Region
AZURE_RESOURCE_GROUP=wolffmlrg
AZURE_REGION=westus2

# Key Vault
AZURE_KEYVAULT_NAME=wolffmlkv
AZURE_KEYVAULT_ENDPOINT=https://wolffmlkv.vault.azure.net/

# AI Foundry
AZURE_AI_ENDPOINT=https://your-ai-instance.openai.azure.com/
AZURE_AI_KEY=your-ai-foundry-key-here
AZURE_AI_DEPLOYMENT=gpt-4

# Storage Account
AZURE_STORAGE_ACCOUNT=wolffautosa
AZURE_STORAGE_KEY=your-storage-account-key-here
AZURE_STORAGE_CONTAINER=graphqueriessamples

# Container Registry
DOCKER_REGISTRY=your-registry.azurecr.io
DOCKER_REGISTRY_USERNAME=your-registry-username
DOCKER_REGISTRY_PASSWORD=your-registry-password

# AKS Cluster
AKS_CLUSTER_NAME=workbookaudit-aks-prod
AKS_RESOURCE_GROUP=wolffmlrg

# Script Configuration
OUTPUT_PATH=C:\temp
SCRIPT_LOG_LEVEL=Verbose
