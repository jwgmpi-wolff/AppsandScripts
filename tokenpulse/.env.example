# Frontend endpoint used by src/data/liveApi.ts
VITE_TOKENPULSE_DATA_URL=/api/tokenpulse

# Azure App Registration – required for browser MSAL (Entra) login
# Create one at https://portal.azure.com > Azure Active Directory > App registrations
# Add http://localhost:5173 as a Single-page application redirect URI
# For multi-tenant selection, set Supported account types to
# "Accounts in any organizational directory" and omit VITE_AZURE_TENANT_ID
VITE_AZURE_CLIENT_ID=your-app-registration-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id

# Local API proxy configuration (server/index.mjs)
PORT=8787
TOKENPULSE_UPSTREAM_BASE_URL=http://localhost:8080/api

# Optional for specific upstream service modes only. Not required for
# local delegated-token live mode used by MSAL Entra login.
# AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# Optional: comma-separated resource types to limit token metric scanning.
# If omitted, TokenPulse scans all resources in the selected subscription and
# keeps only resources that expose token-like Azure Monitor metrics.
# TOKENPULSE_TOKEN_RESOURCE_TYPES=Microsoft.CognitiveServices/accounts,Microsoft.MachineLearningServices/workspaces,Microsoft.ApiManagement/service,Microsoft.Search/searchServices

# Optional cap for how many resources to probe for metric definitions when no
# explicit TOKENPULSE_TOKEN_RESOURCE_TYPES filter is set.
# TOKENPULSE_MAX_RESOURCE_METRIC_PROBES=400

# Optional: if your upstream API requires a static bearer auth token
# (not needed when using MSAL browser login)
# TOKENPULSE_UPSTREAM_BEARER_TOKEN=replace-with-token

# GitHub Actions deployment variables/secrets for Azure App Service
# Repository variables:
# AZURE_WEBAPP_NAME=tokenpulse-yourenv
# AZURE_APP_SERVICE_PLAN_NAME=tokenpulse-plan
# AZURE_RESOURCE_GROUP=rg-tokenpulse
# AZURE_LOCATION=eastus
#
# Repository secrets:
# AZURE_CLIENT_ID=<federated identity app registration client id>
# AZURE_TENANT_ID=<tenant id>
# AZURE_SUBSCRIPTION_ID=<subscription id>
# TOKENPULSE_UPSTREAM_BASE_URL=https://your-tenant-api.example.com
# TOKENPULSE_UPSTREAM_BEARER_TOKEN=<optional token>
