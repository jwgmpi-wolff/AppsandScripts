# Backend local environment template
# Replace all placeholders. Do not commit real secrets.

ASPNETCORE_ENVIRONMENT=Development

# Entra auth placeholders
STOCKSTREAM_AzureAd__TenantId=REPLACE_WITH_TENANT_ID
STOCKSTREAM_AzureAd__ClientId=REPLACE_WITH_BACKEND_API_APP_CLIENT_ID
STOCKSTREAM_AzureAd__Audience=api://REPLACE_WITH_BACKEND_API_APP_CLIENT_ID

# Key Vault placeholder
STOCKSTREAM_KeyVault__Uri=https://REPLACE_WITH_KEYVAULT_NAME.vault.azure.net/

# Provider placeholders
STOCKSTREAM_MarketDataProvider__ProviderName=REPLACE_WITH_PROVIDER_NAME
STOCKSTREAM_MarketDataProvider__BaseUrl=https://REPLACE_WITH_PROVIDER_HOST/
STOCKSTREAM_MarketDataProvider__ApiKeySecretName=market-provider-api-key

# Local-only fallback (optional, avoid in production)
STOCKSTREAM_MarketDataProvider__ApiKey=REPLACE_WITH_LOCAL_DEV_KEY
